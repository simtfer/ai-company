{
  "name": "ai-company",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI company orchestrated by a CEO harness",
  "bin": {
    "aic": "./bin/aic.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/cli.ts mcp",
    "serve": "tsx src/cli.ts serve",
    "demo": "tsx src/cli.ts demo",
    "demo:opencode": "tsx src/cli.ts demo:opencode",
    "demo:harnesses": "tsx src/cli.ts demo:harnesses",
    "demo:sessions": "tsx src/cli.ts demo:sessions",
    "demo:code": "tsx src/cli.ts demo:code",
    "demo:multi-node": "tsx src/cli.ts demo:multi-node",
    "probe": "tsx src/cli.ts probe",
    "metrics": "tsx src/cli.ts metrics",
    "budget": "tsx src/cli.ts budget",
    "backup": "tsx src/cli.ts backup",
    "node:token": "tsx src/cli.ts node:token",
    "node:join": "tsx src/cli.ts node:join",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/aic.mjs",
    "build:sea": "pnpm build && esbuild src/cli.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/aic.cjs && node --build-sea=sea-config.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
